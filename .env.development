# Discourse 嵌入式评论系统配置
# Discourse 实例地址，必须以 / 结尾
VITE_DISCOURSE_URL=http://localhost:4000/
# 前端嵌入评论页的 origin（默认取当前 origin）
# VITE_DISCOURSE_EMBED_ORIGIN=http://localhost:5173
# 是否启用 fullApp 模式（true=可在嵌入页内直接回复/点赞/引用，不跳转）
VITE_DISCOURSE_FULL_APP=true
