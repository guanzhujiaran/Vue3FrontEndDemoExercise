{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "#imports": [
        "./types/nitro-imports"
      ],
      "~/*": [
        "../src/*"
      ],
      "@/*": [
        "../src/*"
      ],
      "~~/*": [
        "../*"
      ],
      "@@/*": [
        "../*"
      ],
      "@unhead/vue": [
        "../node_modules/@unhead/vue"
      ],
      "@nuxt/devtools": [
        "../node_modules/@nuxt/devtools"
      ],
      "@vue/runtime-core": [
        "../node_modules/@vue/runtime-core"
      ],
      "@vue/compiler-sfc": [
        "../node_modules/@vue/compiler-sfc"
      ],
      "@nuxt/schema": [
        "../node_modules/@nuxt/schema"
      ],
      "nuxt": [
        "../node_modules/nuxt"
      ],
      "nuxt-site-config": [
        "../node_modules/nuxt-site-config"
      ],
      "nitropack/types": [
        "../node_modules/nitropack/types"
      ],
      "nitropack/runtime": [
        "../node_modules/nitropack/runtime"
      ],
      "nitropack": [
        "../node_modules/nitropack"
      ],
      "defu": [
        "../node_modules/defu"
      ],
      "h3": [
        "../node_modules/h3"
      ],
      "consola": [
        "../node_modules/consola"
      ],
      "crossws": [
        "../node_modules/crossws"
      ],
      "#nuxtseo/h3": [
        "../node_modules/h3/dist/index"
      ],
      "#shared": [
        "../shared"
      ],
      "#shared/*": [
        "../shared/*"
      ],
      "#server": [
        "../server"
      ],
      "#server/*": [
        "../server/*"
      ],
      "#build": [
        "./"
      ],
      "#build/*": [
        "./*"
      ],
      "#internal/nuxt/paths": [
        "../node_modules/@nuxt/nitro-server/dist/runtime/utils/paths"
      ],
      "@api": [
        "../src/api"
      ],
      "@api/*": [
        "../src/api/*"
      ],
      "@views": [
        "../src/views"
      ],
      "@views/*": [
        "../src/views/*"
      ],
      "@utils": [
        "../src/utils"
      ],
      "@utils/*": [
        "../src/utils/*"
      ],
      "@comp": [
        "../src/components"
      ],
      "@comp/*": [
        "../src/components/*"
      ],
      "@assets": [
        "../src/assets"
      ],
      "@assets/*": [
        "../src/assets/*"
      ],
      "#sitemap": [
        "../node_modules/@nuxtjs/sitemap/dist/runtime"
      ],
      "#sitemap/*": [
        "../node_modules/@nuxtjs/sitemap/dist/runtime/*"
      ],
      "#site-config": [
        "../node_modules/nuxt-site-config/dist/runtime"
      ],
      "#site-config/*": [
        "../node_modules/nuxt-site-config/dist/runtime/*"
      ],
      "#unhead/composables": [
        "../node_modules/nuxt/dist/head/runtime/composables"
      ],
      "#nuxtseo/content": [
        "../node_modules/nuxtseo-shared/dist/runtime/content/none"
      ],
      "#internal/nuxt-robots": [
        "../node_modules/@nuxtjs/sitemap/dist/runtime/server/robots-polyfill"
      ],
      "#internal/nuxt-robots/*": [
        "../node_modules/@nuxtjs/sitemap/dist/runtime/server/robots-polyfill/*"
      ],
      "#app/island-hash": [
        "../node_modules/nuxt/dist/app/island-hash"
      ],
      "#app/island-props": [
        "../node_modules/nuxt/dist/app/island-props"
      ],
      "#app/internal/*": [
        "../node_modules/nuxt/dist/app/internal/*"
      ],
      "#app/types": [
        "../node_modules/nuxt/dist/app/types"
      ]
    },
    "lib": [
      "esnext",
      "webworker",
      "dom.iterable"
    ],
    "noUncheckedIndexedAccess": true,
    "allowArbitraryExtensions": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./types/nitro-nuxt.d.ts",
    "../node_modules/runtime/server",
    "../node_modules/dist/runtime/server",
    "../node_modules/nuxt-site-config/dist/runtime/server",
    "../node_modules/nuxt-site-config/dist/dist/runtime/server",
    "../server/**/*",
    "../shared/**/*.d.ts",
    "./types/nitro.d.ts"
  ],
  "exclude": [
    "../node_modules",
    "../node_modules/nuxt/node_modules",
    "../node_modules/@pinia/nuxt/node_modules",
    "../node_modules/@element-plus/nuxt/node_modules",
    "../node_modules/nuxt-site-config/node_modules",
    "../node_modules/@nuxtjs/sitemap/node_modules",
    "../node_modules/@nuxt/telemetry/node_modules",
    "../dist"
  ]
}