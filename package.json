{
    "name": "bililottery",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/prepare-build.mjs && nuxt dev",
        "build": "node scripts/prepare-build.mjs && nuxt generate",
        "generate": "node scripts/prepare-build.mjs && nuxt generate",
        "preview": "npx --yes serve dist/client -l 4180",
        "postinstall": "nuxt prepare",
        "icons:manifest": "node scripts/gen-action-icon-manifest.mjs",
        "icons:manifest:check": "node scripts/gen-action-icon-manifest.mjs --check",
        "predev": "npm run icons:manifest",
        "prebuild": "npm run icons:manifest",
        "test:e2e": "playwright test",
        "type-check": "nuxt typecheck",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "format": "prettier --write src/",
        "graphqlgen": "graphql-codegen --config codegen.ts"
    },
