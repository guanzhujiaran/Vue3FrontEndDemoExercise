{
    "name": "bililottery",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode development",
        "build": "vite build --mode prod",
        "icons:manifest": "node scripts/gen-action-icon-manifest.mjs",
        "icons:manifest:check": "node scripts/gen-action-icon-manifest.mjs --check",
        "predev": "npm run icons:manifest",
        "prebuild": "npm run icons:manifest",
        "build:no-check": "vite build --mode prod",
        "build:check": "run-p type-check \"build-only {@}\"",
        "test": "vite --mode prod",
        "test:e2e": "playwright test",
        "preview": "vite preview --mode prod",
        "build-only": "vite build --mode prod",
        "type-check": "vue-tsc --build --force",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "format": "prettier --write src/",
        "graphqlgen": "graphql-codegen --config codegen.ts"
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@microsoft/clarity": "^1.0.2",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@urql/vue": "^2.1.1",
        "@vue-flow/background": "^1.3.2",
        "@vue-flow/controls": "^1.1.3",
        "@vue-flow/core": "^1.48.2",
        "@vueuse/components": "^14.4.0",
        "@vueuse/core": "^14.4.0",
        "@vueuse/head": "^2.0.0",
        "axios": "^1.20.0",
        "casdoor-vue-sdk": "^1.6.0",
        "crypto-js": "^4.2.0",
        "daisyui": "^5.7.36",
        "echarts": "^6.1.0",
        "element-plus": "^2.14.5",
        "event-source-polyfill": "^1.0.31",
        "flv.js": "^1.6.2",
        "graphql": "^17.0.2",
        "jsonp": "^0.2.1",
        "mavon-editor": "^3.0.2",
        "md-editor-v3": "^6.5.6",
        "mitt": "^3.0.1",
        "ofetch": "^1.5.1",
        "pinia": "^4.0.3",
        "pinia-plugin-persistedstate": "^4.7.1",
        "sanitize-html": "^2.17.7",
        "unplugin-auto-import": "^21.1.0",
        "unplugin-icons": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vditor": "^4.0.0",
        "vue": "^3.5.42",
        "vue-echarts": "^8.3.0",
        "vue-i18n": "^11.4.10",
        "vue-json-pretty": "^2.6.0",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.4.0",
        "@hey-api/vite-plugin": "0.3.2",
        "@playwright/test": "^1.63.0",
        "@rushstack/eslint-patch": "^1.16.1",
        "@tailwindcss/typography": "^0.5.20",
        "@tsconfig/node20": "^20.1.10",
        "@types/crypto-js": "^4.2.2",
        "@types/lodash": "^4.17.25",
        "@types/node": "^26.1.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitejs/plugin-vue-jsx": "^5.1.6",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/tsconfig": "^0.9.1",
        "autoprefixer": "^10.5.6",
        "npm-run-all2": "^9.0.3",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-sitemap": "^0.8.2",
        "vite-plugin-svg-component": "^1.1.1",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vite-svg-loader": "^5.1.3",
        "vue-tsc": "^3.3.11"
    }
